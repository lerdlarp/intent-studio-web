{
  "name": "intent-studio-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint . && pnpm -r lint",
    "e2e": "pnpm --filter e2e e2e",
    "check:forbidden": "node scripts/check-forbidden.mjs",
    "format": "prettier --write .",
    "eval": "pnpm --filter server exec tsx ../../scripts/eval/run.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
